# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# ---- Database ----
# Local dev (zero setup):
DATABASE_URL=sqlite+aiosqlite:///./mastery.db
# Production:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/mastery

# Let the app create tables at startup. Keep true locally; set false in production,
# where the container entrypoint runs `alembic upgrade head` instead.
AUTO_CREATE_SCHEMA=true

# ---- Cache (optional - app degrades gracefully without it) ----
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# ---- Demo seed ----
# Password for student@demo.local and instructor@demo.local. In production the seed
# skips creating these accounts unless you change this from the default.
DEMO_PASSWORD=demo12345

# ---- Models ----
MODEL_VERSION=bkt-v0.1.0
MODEL_DIR=./models/artifacts

# ---- Tutor policy ----
TARGET_SUCCESS_RATE=0.7
EXPLORATION_RATE=0.15

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
# Optional regex for Vercel preview deployments, e.g.
# CORS_ORIGIN_REGEX=^https://mastery-web-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=
